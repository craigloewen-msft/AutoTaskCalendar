{
  "name": "autotaskcalendar",
  "private": true,
  "description": "Web interface to manage daily tasks and automatically schedule them on your calendar.",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "axios": "^1.13.2",
    "connect-ensure-login": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "es6-promise": "^4.2.8",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "googleapis": "^166.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.19.3",
    "nodemon": "^3.1.11",
    "passport": "^0.7.0",
    "passport-local-mongoose": "^8.0.0"
  },
  "scripts": {
    "build": "cd webinterface && npm install && npm run build && cd .. && rm -rf ./dist && mv ./webinterface/dist .",
    "dev": "npm run db:up && node scripts/dev.js",
    "seed": "npm run db:up && node scripts/seed.js",
    "test": "node scripts/test.js",
    "test:ui": "node scripts/test.js --ui",
    "test:report": "npx playwright show-report",
    "db:up": "scripts/dev-db.sh up",
    "db:down": "scripts/dev-db.sh down",
    "db:reset": "scripts/dev-db.sh reset",
    "db:status": "scripts/dev-db.sh status",
    "db:logs": "scripts/dev-db.sh logs"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.50.0"
  }
}
